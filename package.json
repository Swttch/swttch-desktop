{
  "name": "swttch-desktop",
  "productName": "Swttch",
  "version": "0.1.0-dev",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Swttch Desktop development preview",
  "main": "src/main.cjs",
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@swttch/extend-kit": "0.7.3",
    "@tanstack/react-query": "5.104.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "i18next": "^26.4.5",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "^17.0.16",
    "react-router": "8.4.0",
    "tippy.js": "6.3.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "postinstall": "node scripts/prepare-pty.cjs",
    "start": "electron .",
    "predev": "node scripts/build-source-reader.cjs",
    "dev": "node scripts/dev.mjs --electron",
    "predev:browser": "node scripts/build-source-reader.cjs",
    "dev:browser": "node scripts/dev.mjs",
    "prebuild": "node scripts/build-source-reader.cjs",
    "build": "node scripts/check-syntax.mjs && tsc --project renderer/tsconfig.json && vite build --config renderer/vite.config.mjs",
    "runtime:build": "bash ../../scripts/build.sh be-build && bash ../../scripts/build.sh wv-build",
    "pretest": "node scripts/build-source-reader.cjs",
    "test": "node --test test/*.test.cjs",
    "serve": "node src/host.cjs"
  },
  "packageManager": "pnpm@10.30.1"
}
